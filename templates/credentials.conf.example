# scope/credentials.conf
# Credenciales de prueba para la auditoria. Lo llena el humano.
#
# Por que .conf y no .env: las configuraciones de OpenCode y Claude deniegan editar *.env*,
# que es una defensa util para el .env real del proyecto. Este archivo no cae en esa regla,
# asi que el agente puede crearlo y agregar claves nuevas sin valores.
#
# El agente NUNCA lee este archivo con la herramienta de lectura: resuelve los valores dentro
# del shell y los pasa a curl por archivo, para que no entren al contexto ni a la lista de procesos.
#
# Formato: CLAVE=VALOR, una por linea, sin export y sin comillas.
# Si una clave queda vacia, las pruebas que la necesiten se marcan bloqueadas.
#
# ANTES DE EMPEZAR: agrega "scope/credentials.conf" a .gitignore. No lo versiones nunca.
# Al terminar la auditoria: vacia los valores o borra el archivo.

# --- Rol 1: sin autenticar (anonimo, no requiere credenciales) ---
# No agregues usuario ni clave aqui: el rol anonimo es la ausencia de sesion.
SECTEST_ANON_ENABLED=true

# --- Rol 2: usuario normal A ---
SECTEST_USER_USERNAME=
SECTEST_USER_PASSWORD=
# Codigo TOTP (solo si la app tiene segundo factor). Base32; vacio si no hay MFA.
SECTEST_USER_TOTP_SECRET=

# --- Rol 3: usuario normal B (para IDOR horizontal: A contra B) ---
SECTEST_USER_B_USERNAME=
SECTEST_USER_B_PASSWORD=
SECTEST_USER_B_TOTP_SECRET=

# --- Rol 4: administrador ---
SECTEST_ADMIN_USERNAME=
SECTEST_ADMIN_PASSWORD=
SECTEST_ADMIN_TOTP_SECRET=

# --- Referencias a gestor de secretos (opcional; alternativa a las claves directas) ---
# Formatos: op://Boveda/item/campo | vault://ruta#campo | env:NOMBRE | file:RUTA
# Si defines una REF, deja la clave directa vacia para no duplicar el secreto.
SECTEST_USER_PASSWORD_REF=
SECTEST_ADMIN_PASSWORD_REF=

# --- Extras ---
# El agente agrega aqui las claves que falten, siempre vacias, con la convencion
# SECTEST_<FAMILIA>_<CAMPO>. No inventes valores: si hace falta un acceso nuevo,
# el agente crea la clave y espera a que la cargues.
